<?xml version="1.0"?>
<robot name="soft_tentacle">
  <!-- 16 segments, each with a revolute joint for actuation -->
  <link name="base">
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder length="0.05" radius="0.03"/>
      </geometry>
      <origin xyz="0 0 0.025"/>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.05" radius="0.03"/>
      </geometry>
      <origin xyz="0 0 0.025"/>
    </collision>
  </link>
  <!-- Chain of 16 links and joints -->
  <!-- Each segment is a short cylinder, connected by a revolute joint -->
  <!-- All joints rotate in the y axis for simplicity (can be extended to 2D/3D) -->
  <!-- Segment length: 0.05m, radius: 0.02m -->
  <link name="seg_0">
    <inertial><mass value="0.05"/><origin xyz="0 0 0"/><inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/></inertial>
    <visual><geometry><cylinder length="0.05" radius="0.02"/></geometry><origin xyz="0 0 0.025"/><material name="green"><color rgba="0 1 0 1"/></material></visual>
    <collision><geometry><cylinder length="0.05" radius="0.02"/></geometry><origin xyz="0 0 0.025"/></collision>
  </link>
  <!-- Repeat for seg_1 to seg_15 -->
  <!-- seg_1 to seg_15 and joints -->
